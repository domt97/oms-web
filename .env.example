# Dev proxy targets (npm run dev)
STORE_API_URL=http://localhost:8048
INVENTORY_API_URL=http://localhost:8058

# App config (read at build time)
# API prefix; empty = same origin (Vite proxy in dev, reverse proxy in prod)
VITE_API_BASE_URL=
# Featured shops file served with the app
VITE_STOREFRONT_SHOPS_URL=/storefront-shops.json
# Demo only: also list stores created in the Seller Centre in this browser (defaults to true in dev, false in builds)
VITE_STOREFRONT_DEMO=
VITE_HTTP_TIMEOUT_MS=15000
